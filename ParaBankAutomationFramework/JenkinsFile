
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
    }

    tools {
        maven 'Maven3'
        jdk 'jdk21'
    }

    environment {
        DOCKER_NETWORK     = 'parabank-network'
        SELENIUM_CONTAINER = 'selenium-chrome'
        TEST_IMAGE         = "parabank-tests:${BUILD_NUMBER}"
        TEST_CONTAINER     = "parabank-tests-${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                deleteDir()
                checkout scm
            }
        }

        stage('Verify Tools') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'java -version'
                        sh 'git --version'
                        sh 'docker version'
                    } else {
                        bat 'java -version'
                        bat 'git --version'
                        bat 'docker version'
                    }
                }
            }
        }

        stage('Prepare Selenium Grid') {
            steps {
                script {

                    if (isUnix()) {

                        sh '''
                            docker network inspect "$DOCKER_NETWORK" \
                            >/dev/null 2>&1 || \
                            docker network create "$DOCKER_NETWORK"

                            docker rm -f "$SELENIUM_CONTAINER" \
                            >/dev/null 2>&1 || true

                            docker run -d \
                            --name "$SELENIUM_CONTAINER" \
                            --network "$DOCKER_NETWORK" \
                            -p 4444:4444 \
                            --shm-size=2g \
                            selenium/standalone-chrome:latest
                        '''

                        timeout(time: 3, unit: 'MINUTES') {
                            waitUntil {
                                int status = sh(
                                    returnStatus: true,
                                    script: '''
                                        curl -fsS \
                                        http://localhost:4444/status \
                                        | grep -q '"ready":true'
                                    '''
                                )

                                if (status != 0) {
                                    echo 'Waiting for Selenium Grid...'
                                    sleep 3
                                }

                                return status == 0
                            }
                        }

                        echo 'Selenium Grid is ready.'

                    } else {

                        bat '''
                            docker network inspect %DOCKER_NETWORK% >nul 2>&1 || docker network create %DOCKER_NETWORK%

                            docker rm -f %SELENIUM_CONTAINER% >nul 2>&1

                            docker run -d ^
                            --name %SELENIUM_CONTAINER% ^
                            --network %DOCKER_NETWORK% ^
                            -p 4444:4444 ^
                            --shm-size=2g ^
                            selenium/standalone-chrome:latest
                        '''

                        powershell '''
                            $ready = $false

                            for ($i = 1; $i -le 60; $i++) {

                                try {
                                    $response = Invoke-RestMethod `
                                        -Uri "http://localhost:4444/status" `
                                        -TimeoutSec 5

                                    if ($response.value.ready -eq $true) {
                                        Write-Host "Selenium Grid is ready."
                                        $ready = $true
                                        break
                                    }
                                }
                                catch {
                                    Write-Host "Waiting for Selenium Grid..."
                                }

                                Start-Sleep -Seconds 3
                            }

                            if (-not $ready) {
                                Write-Host "Selenium Grid did not become ready."
                                docker logs $env:SELENIUM_CONTAINER
                                exit 1
                            }
                        '''
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('ParaBankAutomationFramework') {
                    script {

                        if (isUnix()) {
                            sh '''
                                docker build \
                                -f Dockerfile \
                                -t "$TEST_IMAGE" .
                            '''
                        } else {
                            bat '''
                                docker build ^
                                -f Dockerfile ^
                                -t %TEST_IMAGE% .
                            '''
                        }
                    }
                }
            }
        }

        stage('Run Tests in Docker') {
            steps {
                dir('ParaBankAutomationFramework') {
                    script {

                        int testStatus

                        if (isUnix()) {

                            sh '''
                                docker rm -f "$TEST_CONTAINER" \
                                >/dev/null 2>&1 || true
                            '''

                            testStatus = sh(
                                returnStatus: true,
                                script: '''
                                    docker run \
                                    --name "$TEST_CONTAINER" \
                                    --network "$DOCKER_NETWORK" \
                                    "$TEST_IMAGE"
                                '''
                            )

                            sh '''
                                rm -rf target/surefire-reports
                                rm -rf test-output
                                rm -rf screenshots

                                mkdir -p target

                                docker cp \
                                "$TEST_CONTAINER":/app/target/surefire-reports \
                                target/ || true

                                docker cp \
                                "$TEST_CONTAINER":/app/test-output \
                                . || true

                                docker cp \
                                "$TEST_CONTAINER":/app/screenshots \
                                . || true

                                docker rm -f "$TEST_CONTAINER" \
                                >/dev/null 2>&1 || true
                            '''

                        } else {

                            bat(
                                returnStatus: true,
                                script: '''
                                    docker rm -f %TEST_CONTAINER%
                                '''
                            )

                            testStatus = bat(
                                returnStatus: true,
                                script: '''
                                    docker run ^
                                    --name %TEST_CONTAINER% ^
                                    --network %DOCKER_NETWORK% ^
                                    %TEST_IMAGE%
                                '''
                            )

                            bat '''
                                if exist target\\surefire-reports (
                                    rmdir /s /q target\\surefire-reports
                                )

                                if exist test-output (
                                    rmdir /s /q test-output
                                )

                                if exist screenshots (
                                    rmdir /s /q screenshots
                                )

                                if not exist target (
                                    mkdir target
                                )
                            '''

                            bat(
                                returnStatus: true,
                                script: '''
                                    docker cp ^
                                    %TEST_CONTAINER%:/app/target/surefire-reports ^
                                    target\\
                                '''
                            )

                            bat(
                                returnStatus: true,
                                script: '''
                                    docker cp ^
                                    %TEST_CONTAINER%:/app/test-output ^
                                    .
                                '''
                            )

                            bat(
                                returnStatus: true,
                                script: '''
                                    docker cp ^
                                    %TEST_CONTAINER%:/app/screenshots ^
                                    .
                                '''
                            )

                            bat(
                                returnStatus: true,
                                script: '''
                                    docker rm -f %TEST_CONTAINER%
                                '''
                            )
                        }

                        if (testStatus != 0) {
                            error('Tests failed inside Docker container.')
                        }
                    }
                }
            }
        }
    }

    post {

        always {

            junit(
                testResults:
                    'ParaBankAutomationFramework/target/surefire-reports/*.xml',
                allowEmptyResults: true
            )

            archiveArtifacts(
                artifacts:
                    'ParaBankAutomationFramework/target/surefire-reports/**/*,' +
                    'ParaBankAutomationFramework/test-output/**/*,' +
                    'ParaBankAutomationFramework/screenshots/**/*',
                allowEmptyArchive: true
            )

            publishHTML(target: [
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir:
                    'ParaBankAutomationFramework/test-output',
                reportFiles:
                    'ExtentReport.html',
                reportName:
                    'ParaBank Extent Report'
            ])

            script {

                if (isUnix()) {

                    sh '''
                        docker rm -f "$TEST_CONTAINER" \
                        >/dev/null 2>&1 || true

                        docker rm -f "$SELENIUM_CONTAINER" \
                        >/dev/null 2>&1 || true

                        docker image rm -f "$TEST_IMAGE" \
                        >/dev/null 2>&1 || true
                    '''

                } else {

                    bat(
                        returnStatus: true,
                        script: '''
                            docker rm -f %TEST_CONTAINER%
                            docker rm -f %SELENIUM_CONTAINER%
                            docker image rm -f %TEST_IMAGE%
                        '''
                    )
                }
            }
        }

        success {
            echo 'ParaBank Docker test execution completed successfully.'
        }

        failure {
            echo 'ParaBank Docker test execution failed. Check reports and screenshots.'
        }
    }
}
