pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    tools {
        maven 'Maven3'
        jdk 'jdk21'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Tools') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'java -version'
                        sh 'mvn -version'
                        sh 'git --version'
                    } else {
                        bat 'java -version'
                        bat 'mvn -version'
                        bat 'git --version'
                    }
                }
            }
        }

        stage('Build and Run Tests') {
            steps {
                dir('ParaBankAutomationFramework') {
                    script {
                        if (isUnix()) {
                            sh 'mvn clean test -Dheadless=true'
                        } else {
                            bat 'mvn clean test -Dheadless=true'
                        }
                    }
                }
            }
        }
    }

    post {

        always {

            junit testResults:
                'ParaBankAutomationFramework/target/surefire-reports/*.xml',
                allowEmptyResults: true

            archiveArtifacts artifacts:
                'ParaBankAutomationFramework/target/surefire-reports/**/*,ParaBankAutomationFramework/test-output/**/*,ParaBankAutomationFramework/screenshots/**/*',
                allowEmptyArchive: true

            publishHTML(target: [
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'ParaBankAutomationFramework/test-output',
                reportFiles: 'ExtentReport.html',
                reportName: 'ParaBank Extent Report'
            ])
        }

        success {
            echo 'ParaBank test execution completed successfully.'
        }

        failure {
            echo 'ParaBank test execution failed. Check the console output and screenshots.'
        }
    }
}