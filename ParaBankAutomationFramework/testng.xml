<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="ParaBank Suite"
	parallel="false"
	preserve-order="true">

	<listeners>
		<listener class-name="listeners.TestListener" />
	</listeners>

	<test name="ParaBank Tests"
		preserve-order="true">

		<classes>

			<class name="testcases.RegistrationTest" />

			<class name="testcases.LoginTest" />

			<class name="testcases.OpenAccountTest" />

			<class name="testcases.TransferFundsTest" />

			<class name="testcases.BillPayTest" />

			<class name="testcases.NegativeTest" />

		</classes>

	</test>

</suite>